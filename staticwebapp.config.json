{
  "trailingSlash": "never",
  "routes": [
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    }
  ],
  "mimeTypes": {
    ".css": "text/css; charset=utf-8",
    ".js": "text/javascript; charset=utf-8"
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  }
}
